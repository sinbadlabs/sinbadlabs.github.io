---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.static_files | where: "extname", ".html" | where_exp: "file", "file.sitemap != false" %}
{%- assign paths = pages | map: "path" %}
{%- for page in site.html_pages %}
  {%- assign extension = page.name | split: "." | last %}
  {%- if extension == "html" and page.sitemap != false %}
    {%- assign paths = paths | push: page.url %}
  {%- endif %}
{%- endfor %}
{%- assign paths = paths | sort %}
{%- for path in paths %}
  {%- unless path == "/404.html" or path == "/privacy/colorpad.html" or path == "/terms/colorpad.html" %}
  <url>
    <loc>{{ path | replace: "/index.html", "/" | absolute_url | xml_escape }}</loc>
  </url>
  {%- endunless %}
{%- endfor %}
</urlset>
